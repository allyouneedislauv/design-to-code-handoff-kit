{
  "color": {
    "blue": {
      "100": { "$value": "#dae8ff", "$type": "color" },
      "200": { "$value": "#b5cdff", "$type": "color" },
      "400": { "$value": "#7C9FE8", "$type": "color" },
      "600": { "$value": "#4A6FD1", "$type": "color" },
      "700": { "$value": "#3A5AB0", "$type": "color" }
    },
    "pink": {
      "100": { "$value": "#ffd4e1", "$type": "color" },
      "200": { "$value": "#feabc5", "$type": "color" },
      "400": { "$value": "#E85F8A", "$type": "color" }
    },
    "neutral": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "100": { "$value": "#F2F2F5", "$type": "color" },
      "400": { "$value": "#A0A0A8", "$type": "color" },
      "600": { "$value": "#6B6B70", "$type": "color" },
      "900": { "$value": "#1A1A1A", "$type": "color" }
    },
    "green": {
      "100": { "$value": "#DCF2E7", "$type": "color" },
      "400": { "$value": "#4CAF7D", "$type": "color" }
    },
    "red": {
      "100": { "$value": "#FBDCDA", "$type": "color" },
      "400": { "$value": "#E8615F", "$type": "color" }
    }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{color.blue.600}", "$type": "color" },
      "primary-hover": { "$value": "{color.blue.700}", "$type": "color" },
      "primary-light": { "$value": "{color.blue.200}", "$type": "color" },
      "accent": { "$value": "{color.pink.400}", "$type": "color" },
      "text-primary": { "$value": "{color.neutral.900}", "$type": "color" },
      "text-secondary": { "$value": "{color.neutral.600}", "$type": "color" },
      "text-placeholder": { "$value": "{color.neutral.400}", "$type": "color" },
      "surface": { "$value": "{color.neutral.white}", "$type": "color" },
      "border": { "$value": "{color.neutral.100}", "$type": "color" },
      "success": { "$value": "{color.green.400}", "$type": "color" },
      "success-bg": { "$value": "{color.green.100}", "$type": "color" },
      "danger": { "$value": "{color.red.400}", "$type": "color" },
      "danger-bg": { "$value": "{color.red.100}", "$type": "color" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" }
  },
  "shadow": {
    "sm": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "0px",
        "color": "rgba(0, 0, 0, 0.08)"
      },
      "$type": "shadow"
    }
  }
}
